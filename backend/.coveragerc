    app/application/services/admin_accounts.py
    app/application/services/oauth_consent/service.py
    app/application/services/voice_multimodal.py
    app/application/services/paper_trading_service.py
    app/application/services/supervisor/runtime.py
    app/application/services/supervisor/shared_context.py
    app/application/services/supervisor/session_audit_digest.py
    app/application/services/supervisor/session_service.py
    app/application/services/forager_service.py
    app/application/services/dreamer_service.py
    app/application/services/monitoring_snapshot.py
    app/application/services/billing.py
    app/application/services/stripe_runtime_credentials.py
    app/application/services/skill_checkout.py
    app/application/services/recipe_chroma_bridge.py

[report]
# Gate is tuned to the omission-heavy CI slice;raising this requires expanding integration tests beyond HTTP routers.
# Post–dashboard merge (2026-05): executor + task surfaces are integration-tested on host; raise toward 80% with focused suites.
# Coverage gate for regression slices — Phase 3.5 raises toward Queenswarm backend target (see AUDIT_REPORT).
fail_under = 80
show_missing = true
skip_covered = false

    app/application/services/dashboard_foragers_overview.py
    app/application/services/dashboard_swarms_overview.py
    app/application/services/enterprise_alerting.py
    # HTTP routers covered by Playwright / manual sign-off (thin wrappers)
    app/presentation/api/routers/shares.py
    app/presentation/api/routers/curated_memory.py
    app/presentation/api/routers/dreaming.py
    app/presentation/api/routers/paper_trading.py
    app/presentation/api/routers/platform_features_admin.py

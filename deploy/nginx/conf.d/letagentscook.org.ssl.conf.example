# Append after certbot issues /etc/letsencrypt/live/letagentscook.org/
# Rename to letagentscook.org.ssl.conf and reload nginx.

server {
    listen 80;
    listen [::]:80;
    server_name letagentscook.org www.letagentscook.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name letagentscook.org www.letagentscook.org;

    ssl_certificate /etc/letsencrypt/live/letagentscook.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/letagentscook.org/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:QS_SSL:10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    proxy_http_version 1.1;
    client_max_body_size 15m;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ^~ /api/v1/ {
        set $upstream_api backend:8000;
        proxy_pass http://$upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /health {
        set $upstream_api backend:8000;
        proxy_pass http://$upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $upstream_next frontend:3000;
        proxy_pass http://$upstream_next;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
    }
}

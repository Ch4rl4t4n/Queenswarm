# Alertmanager Slack receiver — __SLACK_WEBHOOK_URL__ replaced by scripts/render-alertmanager-config.sh
global:
  resolve_timeout: 5m

route:
  receiver: slack-queenswarm
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    - matchers:
        - severity = critical
      receiver: slack-queenswarm
      repeat_interval: 2h
    - matchers:
        - alertname =~ "^Pattern.*"
      receiver: slack-queenswarm
      group_by: ["alertname", "pattern_id", "severity"]
      repeat_interval: 3h

receivers:
  - name: slack-queenswarm
    slack_configs:
      - api_url: "__SLACK_WEBHOOK_URL__"
        send_resolved: true
        title: '{{ if eq .Status "firing" }}🚨 Queenswarm alert{{ else }}✅ Resolved{{ end }} · {{ .GroupLabels.alertname }}'
        text: |-
          {{ range .Alerts -}}
          *{{ .Labels.alertname }}* ({{ .Labels.severity }})
          {{ .Annotations.summary }}
          {{ if .Labels.pattern_id }}Pattern: `{{ .Labels.pattern_id }}`{{ end }}
          {{ end }}
        color: '{{ if eq .Status "firing" }}{{ if eq .CommonLabels.severity "critical" }}danger{{ else }}warning{{ else }}good{{ end }}'

inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: ["alertname", "pattern_id"]

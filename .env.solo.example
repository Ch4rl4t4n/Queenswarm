# =============================================================================
# Queenswarm SOLO + PERSONAL OS preset — merged by scripts/apply-solo-mode.sh
# =============================================================================
# One admin operator: daily Personal OS stack (agents, memory, marketing lane).
# Hides revenue funnel, Gumroad widgets, trading cockpit, beta labs, B2B surfaces.
# Requires SOLO_MODE_ENABLED=true. Flip PERSONAL_OS_MODE_ENABLED=false to restore
# solo revenue stack without re-enabling multi-tenant commercial.

SOLO_MODE_ENABLED=true
PERSONAL_OS_MODE_ENABLED=true
DEFAULT_TENANT_PLATFORM_MODE=internal
PRODUCTION_SECURITY_MODE=true

# Guest / M2M off
BALLROOM_GUEST_WS=false
HIVE_DASHBOARD_GUEST_WS=false

# Commercial / gamification — OFF in Personal OS
LEADERBOARD_ENABLED=false
VERIFIED_POLLEN_LEADERBOARD_ENABLED=false
SKILL_MARKETPLACE_UGC_ENABLED=false
BEE_GAMIFICATION_ENABLED=false
UGC_CONTENT_ENGINE_ENABLED=false
RECIPE_MARKETPLACE_BETA_ENABLED=false
MEDIA_AGENCY_IN_A_BOX_ENABLED=false
MICRO_SAAS_FACTORY_ENABLED=false
SKILL_EXPORT_PREMIUM_ENABLED=false
ENTERPRISE_WORKSPACE_ENABLED=false

# Mission Home — strip revenue funnel widgets (MK9–MK11 / REV4)
REVENUE_FUNNEL_MISSION_HOME_ENABLED=false
CATALOG_WAVE_MISSION_HOME_ENABLED=false
FACTORY_LAUNCH_MISSION_HOME_ENABLED=false
CATALOG_WAVE_SEED_BATCH_ENABLED=false

# Background jobs — keep agent scheduler + stale sweep
HOURLY_YOUTUBE_CRYPTO_ROLL_ENABLED=false
SUPERVISOR_AUDIT_DIGEST_ENABLED=true
TENANT_AUDIT_RETENTION_ENABLED=true
ALERTING_ENABLED=true
AGENT_STALE_SWEEP_ENABLED=true

# Operator stack — simplified (no trading cockpit / paper lane)
OPERATOR_LOOP_ENABLED=true
OPERATOR_HUB_SETTINGS_ENABLED=true
AGENT_OS_ENABLED=true
TRADING_COCKPIT_ENABLED=false
PUBLISH_PERFORMANCE_ENABLED=true
RESEARCH_BEE_ENABLED=true
PAPER_TRADING_ENABLED=false

# Live publish — OFF until OAuth connected in Integrations
SOCIAL_PUBLISH_LIVE_ENABLED=false
PREDICTION_MARKETS_LIVE_TRADING_ENABLED=false
SOCIAL_PUBLISH_TRUSTED_AUTO_ENABLED=false
SUPERVISOR_PATTERN_ROUTER_LLM_ENABLED=false
# Fast session create — queue Celery steps instead of blocking HTTP on LLM
SUPERVISOR_DURABLE_MODE_ENABLED=true
SUPERVISOR_DEFAULT_RUNTIME_MODE=durable

# Core on — full agent/knowledge stack
RECIPES_ENABLED=true
SIMULATIONS_ENABLED=false
VOICE_ENABLED=true
DREAMING_ENABLED=true
ROUTINES_ENABLED=true
API_KEY_MANAGEMENT_ENABLED=true
CELERY_WORKER_CONCURRENCY=3

# Optional modules — default ON for admin
FORAGER_INTELLIGENCE_LOOP_ENABLED=true

# Frontend build-time hints (must rebuild frontend after change)
NEXT_PUBLIC_SOLO_MODE=true
NEXT_PUBLIC_PERSONAL_OS_MODE=true
NEXT_PUBLIC_QS_POLL_PROFILE=vps_32gb
NEXT_PUBLIC_LEADERBOARD_ENABLED=false
NEXT_PUBLIC_RECIPES_ENABLED=true
NEXT_PUBLIC_VOICE_ENABLED=true
NEXT_PUBLIC_HIVE_WS_GUEST=false
NEXT_PUBLIC_BALLROOM_GUEST_WS=false

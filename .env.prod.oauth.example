# OAuth credentials overlay — copy to .env.prod.oauth (gitignored, chmod 600).
# Backend: .env.prod + this file (overlay wins on duplicate keys).
#
# Quick start:
#   MERGE=1 ./scripts/operator-oauth-env-init.sh
#   ./scripts/operator-meta-oauth-prep.sh          # Meta 15-min checklist
#   # fill OAUTH_META_* below
#   REDEPLOY=1 ./scripts/operator-oauth-redeploy.sh
#   # UI: Integrations → Marketplace → Instagram → Hub → Connect
#   RUN_SIMULATE=1 CONFIRM_LIVE=1 ./scripts/operator-publish-live-rollout.sh
#
# Full guide: docs/OPERATOR_PUBLISH_LIVE_15MIN.md

OAUTH_FRONTEND_PUBLIC_ORIGIN=https://queenswarm.love
OAUTH_REDIRECT_URI=https://queenswarm.love/api/auth/callback/oauth

# --- PRIORITY: Meta Instagram + Facebook (publish lane) ---
# Meta Developer → Business App → Instagram Graph API + Facebook Login
# Redirect URI must match OAUTH_REDIRECT_URI exactly.
OAUTH_META_CLIENT_ID=
OAUTH_META_CLIENT_SECRET=
# Facebook Login for Business → Configurations → copy config_id (required for Instagram use-case apps)
OAUTH_META_CONFIG_ID=

# --- Optional social channels (later) ---
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_TIKTOK_CLIENT_KEY=
OAUTH_TIKTOK_CLIENT_SECRET=

# --- Virtual Company connectors (Notion / Gmail / GitHub app OAuth) ---
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional manual tokens — bypass OAuth app registration for Notion + GitHub.
# Copy to .env.prod.tokens (gitignored). Gmail still needs Google OAuth in .env.prod.oauth.
#
#   cp .env.prod.tokens.example .env.prod.tokens
#   APPLY=1 ./scripts/operator-vc-manual-tokens.sh

# Notion internal integration secret (https://www.notion.so/profile/integrations)
NOTION_INTEGRATION_TOKEN=

# GitHub fine-grained or classic PAT (repo scope for R&D lane)
GITHUB_PAT=

# Gmail SMTP for digest emails + operator alerts (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# Telegram bot (@BotFather token + chat id for operator alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

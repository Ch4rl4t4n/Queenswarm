{
  "name": "queenswarm-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "next dev --turbopack",
    "dev:fresh": "npm run clean && next dev --turbopack",
    "build": "next build",
    "build:fresh": "npm run clean && next build",
    "start": "next start",
    "start:fresh": "npm run build:fresh && next start",
    "lint": "eslint .",
    "lint:next": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/responsive-visual.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/responsive-visual.spec.ts --update-snapshots",
    "test:e2e:pwa": "playwright test e2e/pwa-shell.spec.ts",
    "test:e2e:phase70": "playwright test e2e/phase70-consolidated-navigation.spec.ts",
    "test:e2e:phase120": "playwright test e2e/phase120-ecosystem-integration.spec.ts",
    "test:e2e:phase14": "playwright test e2e/phase14-operator-flows.spec.ts",
    "test:e2e:execution-studio": "playwright test e2e/execution-studio.spec.ts",
    "test:e2e:execution-studio-supervisor": "playwright test e2e/execution-studio-supervisor-flow.spec.ts",
    "test:e2e:publish-lane": "playwright test e2e/publish-lane.spec.ts",
    "test:e2e:operator-hub": "playwright test e2e/operator-hub-settings.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.25",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.16.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^15.5.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.18",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}

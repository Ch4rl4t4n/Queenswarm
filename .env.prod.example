# =============================================================================
# Queenswarm PRODUCTION — copy to ``.env.prod`` (gitignored). Host: queenswarm.love
# =============================================================================
# Tuned for a **~32 GB RAM** single host alongside ``docker-compose.prod.yml`` caps
# (see overlay: postgres/redis/neo4j/backend/celery). For ~16 GB, reduce mem_limit locally.
# Never commit this file with real secrets; rotate quarterly per security policy.

DOMAIN=queenswarm.love
# Optional: override nginx default vhost file (default is production ``conf.d/queenswarm.love.conf``).
# QS_NGINX_SITE_CONF=./deploy/nginx/conf.d/queenswarm.love.conf

# ----- TLS (host; paths referenced in deploy/nginx/queenswarm.love.conf) -----
#   /etc/letsencrypt/live/queenswarm.love/{fullchain.pem,privkey.pem}
# Include ``www.queenswarm.love`` in the same cert if you serve both hostnames.

NEXT_PUBLIC_API_BASE=https://queenswarm.love/api/v1
CORS_ORIGINS=https://queenswarm.love,https://www.queenswarm.love
OAUTH_FRONTEND_PUBLIC_ORIGIN=https://queenswarm.love

# Production OAuth apps (redirect ``https://queenswarm.love/api/auth/callback/oauth``)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=
OAUTH_STRIPE_CLIENT_ID=
OAUTH_STRIPE_CLIENT_SECRET=

SECRET_KEY=openssl-rand-hex-32-production-min-64-chars-when-prod-mode
CONNECTOR_VAULT_FERNET_KEY=replace-with-fernet-key-from-generate-env-secrets-sh
DASHBOARD_JWT=mint-with-backend-scripts-issue_dashboard_jwt-py-production

POSTGRES_USER=queenswarm
POSTGRES_PASSWORD=production-postgres-password
POSTGRES_DB=queenswarm
POSTGRES_URL=postgresql+asyncpg://queenswarm:production-postgres-password@postgres:5432/queenswarm

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=production-neo4j-password

VECTOR_STORE_BACKEND=pgvector
# Legacy rollback only:
# VECTOR_STORE_BACKEND=chroma
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

GROK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

GRAFANA_PASSWORD=production-grafana-admin
GF_SERVER_ROOT_URL=https://queenswarm.love/grafana/

NEXT_PUBLIC_QS_POLL_PROFILE=low_ram
LLM_MAX_CONCURRENCY=8
SIMULATION_MAX_PARALLEL=3
CELERY_WORKER_CONCURRENCY=3
SIMULATIONS_ENABLED=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_WAIT_SEC=0.35
LLM_RETRY_MAX_WAIT_SEC=4.0
HEALTH_DEPENDENCY_TIMEOUT_SEC=2.0

# ----- Phase 13.1 — horizontal scaling / multi-instance -----
SCALING_MODE_ENABLED=true
INSTANCE_ID=prod-api-1
WORKER_COUNT=2
DISTRIBUTED_LOCK_TTL_SEC=45
DISTRIBUTED_LOCK_RENEW_INTERVAL_SEC=15.0
HA_MODE_ENABLED=false
# REDIS_FAILOVER_URLS=redis://redis-replica:6379/0
POSTGRES_REPLICA_URLS=
GRACEFUL_SHUTDOWN_TIMEOUT_SEC=20
GRACEFUL_SHUTDOWN_DRAIN_SEC=5
ENTERPRISE_MONITORING_ENABLED=true
OPENTELEMETRY_ENABLED=true
OPENTELEMETRY_SERVICE_NAME=queenswarm-api-prod
# OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ALERTING_ENABLED=true
ALERT_MEMORY_PERCENT_THRESHOLD=90.0
ALERT_SUPERVISOR_FAILURES_THRESHOLD=2
ALERT_RATE_LIMIT_BLOCKS_5M_THRESHOLD=80
ALERT_SCALING_EVENTS_5M_THRESHOLD=8
ALERT_DISPATCH_COOLDOWN_SEC=300
# PAGERDUTY_ROUTING_KEY=

# PRODUCTION_HEALTH_URL=https://queenswarm.love/health

# ----- Phase 5.2 — post-deploy probes (optional) -----
# OPERATOR_SMOKE_JWT=   # export after minting JWT; used by scripts/health-check.sh
# POST_DEPLOY_HEALTH=1 ./scripts/deploy-prod.sh

# ----- JWT & rate limits (required for release) -----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_ENABLED=true
PRODUCTION_SECURITY_MODE=true

# ----- Settings: 2FA + API keys (backend gates for /auth/profile/totp/* and /auth/api-keys) -----
ENABLE_2FA=true
SECURITY_2FA_ADVANCED_ENABLED=true
API_KEY_MANAGEMENT_ENABLED=true

# ----- Frontend legal URLs -----
NEXT_PUBLIC_TERMS_URL=https://queenswarm.love/terms
NEXT_PUBLIC_PRIVACY_URL=https://queenswarm.love/privacy

# ----- Voice (enable only when STT/TTS provider keys are configured) -----
VOICE_ENABLED=false

# ----- HA (enable redis-replica via DEPLOY_HA_PROFILE=1) -----
HA_MODE_ENABLED=false
# REDIS_FAILOVER_URLS=redis://redis-replica:6379/0

# ----- Readiness strict deps -----
# READINESS_REQUIRE_NEO4J=false
# READINESS_REQUIRE_CHROMA=false

# ----- Hive Mind + vectors -----
# HIVE_MIND_ENABLED=true
# HIVE_MIND_CHROMA_ENABLED=true

# ----- Ballroom / dashboard WebSocket -----
# BALLROOM_GUEST_WS=true
# HIVE_DASHBOARD_GUEST_WS=true

# ----- Phase 14 — marketplace, paper trading, outcome gate -----
RECIPES_ENABLED=true
LEADERBOARD_ENABLED=true
SKILL_EXPORT_PREMIUM_ENABLED=true
PAPER_TRADING_ENABLED=true
PENDING_REVIEW_ENABLED=true
VERIFIED_POLLEN_LEADERBOARD_ENABLED=true
AGENT_STALE_SWEEP_ENABLED=true
RECIPE_HYBRID_SCORING_ENABLED=true
RECIPE_HYBRID_NEO4J_ENABLED=true
LANGFUSE_ENABLED=false

# Stripe Checkout for premium skill export (required when SKILL_EXPORT_PREMIUM_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SKILLS_SUCCESS_URL=https://queenswarm.love/integrations?tab=skills&purchase=success
STRIPE_SKILLS_CANCEL_URL=https://queenswarm.love/integrations?tab=skills&purchase=cancel
# Local webhook forward: ./scripts/stripe-webhook-dev.sh
# After keys are set in production: ./scripts/finish-stripe-setup.sh

# ----- Sign-off gate (run before declaring prod ready) -----
# ./scripts/production-signoff-gate.sh
# PLAYWRIGHT_BASE_URL=https://queenswarm.love ./scripts/production-signoff-gate.sh
# STRICT_STRIPE=1 ./scripts/production-signoff-gate.sh
